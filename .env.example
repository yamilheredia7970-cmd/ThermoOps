# Reverb (real-time) connection details. VITE_REVERB_APP_KEY is a public
# identifier (like a Pusher app key), safe to expose to the browser; it must
# match REVERB_APP_KEY in backend/.env. The secret used to sign broadcast
# auth requests stays server-side only and is never read by the frontend.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
